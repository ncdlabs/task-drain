#!/usr/bin/env bash
export PATH=/opt/homebrew/bin:/usr/local/bin:$HOME/.opencode/bin:$HOME/bin:/usr/bin:/bin:/usr/sbin:/sbin
#
# drain -- CLI for the task-drain autonomous worker pool.
# Worker logic lives in the adjacent task-drain.sh; this is the human interface.
#
#   drain                show this help
#   drain status [project] [-w|--watch] [--workers] [--verbose]
#                        show status (workers, kill switch, queue),
#                        optionally scoped to one project; -w keeps a
#                        live display (q quits, DRAIN_WATCH_INTERVAL=5);
#                        --workers shows a live per-worker view instead:
#                        each worker's current task + time-budget meter;
#                        --verbose (or DRAIN_VERBOSE=1) shows full lists
#                        instead of the capped summary view
#   drain docs           how pickup, tags, and the kill switch work
#   drain start [N] [project|all] [--failed] [--persist]
#                        start N background workers (default 2, max 8),
#                        optionally limited to one project, e.g.:
#                          drain start 3 attendeesync
#                        'all' (or no project) = take tasks from any project.
#                        --failed = reprocess drain-failed tasks instead of
#                        the regular queue, e.g.:
#                          drain start 2 attendeesync --failed
#                        --persist = workers wait for new jobs after the queue
#                        empties instead of exiting, e.g.:
#                          drain start 2 attendeesync --persist
#   drain stop [N|all]   graceful stop: workers finish their current task,
#                        pick up nothing new, then exit.
#                        No arg (or 'all') = stop ALL workers.
#                        N = stop N workers (newest first).
#                        --force = immediate stop (TERM mid-task, like drain kill)
#   drain kill           immediate stop: TERM workers mid-task (in-flight
#                        tasks are released back to pending, cleanly)
#   drain autoscale [project] [--min N] [--max N]
#                        supervisor daemon: watches queue depth and scales
#                        workers up/down automatically. Defaults: --min 1,
#                        --max 8. Env: DRAIN_MIN_WORKERS, DRAIN_MAX_WORKERS,
#                        DRAIN_AUTOSCALE_INTERVAL (sec, default 30),
#                        DRAIN_TASKS_PER_WORKER (default 2).
#   drain autoscale-stop stop the autoscaler (workers keep running)
#   drain unfail [project] remove drain-failed tag from failed tasks,
#                        returning them to the regular queue
#   drain resume         clear the STOP file (does not start workers)
#   drain logs [-f]      tail worker logs (follow with -f)
#   drain projects       list configured project → repo mappings
#   drain projects merge <destination> <source...>
#                        merge source projects into destination (moves all tasks)
#   drain help
#
# Workers log to ~/.task-drain/logs/worker-<timestamp>-<pid>-N.log.
#
set -euo pipefail

# Resolve symlinks so the script finds its siblings even when invoked
# through ~/bin/drain -> repo/bin/drain. macOS readlink lacks -f.
resolve_symlink() {
  local path="$1" target
  while [ -L "$path" ]; do
    target=$(readlink "$path")
    if [[ "$target" != /* ]]; then
      target="$(dirname -- "$path")/$target"
    fi
    path="$target"
  done
  printf '%s\n' "$path"
}

SCRIPT_PATH="$(resolve_symlink "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)"
DRAIN_SCRIPT="$SCRIPT_DIR/task-drain.sh"
DRAIN_HOME="$HOME/.task-drain"
LOG_DIR="$DRAIN_HOME/logs"
STOP_FILE="$DRAIN_HOME/STOP"

# Source shared worker detection functions
# shellcheck source=lib/worker-detect.sh
source "$SCRIPT_DIR/lib/worker-detect.sh"

die() { echo "drain: $*" >&2; exit 1; }

need_script() { [ -f "$DRAIN_SCRIPT" ] || die "worker script not found: $DRAIN_SCRIPT"; }

worker_pids() {
  # Use shared worker detection from lib/worker-detect.sh
  drain_worker_pids
}

worker_count() {
  local ps_out
  ps_out=$(worker_pids)
  if [ -z "$ps_out" ]; then echo 0; else printf '%s\n' "$ps_out" | wc -l | tr -d ' '; fi
}

prune_stale_stops() {
  # Drop per-worker STOP.<pid> files whose worker is already gone.
  local f pid alive
  alive=$(worker_pids)
  for f in "$DRAIN_HOME"/STOP.*; do
    [ -e "$f" ] || continue
    pid=${f##*.}
    [[ "$pid" =~ ^[0-9]+$ ]] || continue
    if ! printf '%s\n' "$alive" | grep -qx "$pid"; then rm -f "$f"; fi
  done
}

cmd_status() { # [project] [-w|--watch] [--workers] [--verbose]
  need_script
  local project="" watch=0 workers=0 verbose=0 a
  for a in "$@"; do
    case "$a" in
      -w|--watch) watch=1 ;;
      --workers) workers=1 ;;
      -v|--verbose) verbose=1 ;;
      -*) die "unknown status option: $a (try: drain help)" ;;
      *) [ -z "$project" ] || die "unexpected argument: $a (try: drain help)"; project="$a" ;;
    esac
  done
  [ "$project" = "all" ] && project=""
  if [ "$workers" = 1 ]; then
    PROJECT_FILTER="$project" bash "$DRAIN_SCRIPT" workers
  elif [ "$watch" = 1 ]; then
    if [ "$verbose" = 1 ]; then export DRAIN_VERBOSE=1; fi
    PROJECT_FILTER="$project" bash "$DRAIN_SCRIPT" watch
  else
    if [ "$verbose" = 1 ]; then export DRAIN_VERBOSE=1; fi
    PROJECT_FILTER="$project" bash "$DRAIN_SCRIPT" status
  fi
}

cmd_start() { # [N] [project|all] [--failed] [--persist]
  need_script
  local n="" project="" retry=0 persist=0 running i logf a
  for a in "$@"; do
    case "$a" in
      "") ;;
      --failed) retry=1 ;;
      --persist) persist=1 ;;
      *)
        if [[ "$a" =~ ^[0-9]+$ ]] && [ -z "$n" ]; then n="$a"
        elif [ -z "$project" ]; then project="$a"
        else die "unexpected argument: $a (try: drain help)"; fi ;;
    esac
  done
  [ -n "$n" ] || n=2
  [[ "$n" =~ ^[1-9][0-9]*$ ]] || die "N must be a positive integer"
  [ "$n" -le 8 ] || die "max 8 workers"
  [ "$project" = "all" ] && project=""
  mkdir -p "$LOG_DIR"
  if [ -e "$STOP_FILE" ]; then rm -f "$STOP_FILE"; echo "cleared STOP file."; fi
  prune_stale_stops
  running=$(worker_count)
  if [ "$running" -gt 0 ]; then echo "note: $running worker(s) already running; starting $n more."; fi
  [ -n "$project" ] && export PROJECT_FILTER="$project"
  [ "$retry" = 1 ] && export DRAIN_RETRY_FAILED=1
  [ "$persist" = 1 ] && export DRAIN_PERSIST=1
  local mode_desc=""
  [ -n "$project" ] && mode_desc=" [project=$project]"
  [ "$retry" = 1 ] && mode_desc="$mode_desc [retrying failed]"
  [ "$persist" = 1 ] && mode_desc="$mode_desc [persist]"
  for i in $(seq 1 "$n"); do
    # Timestamp + CLI pid in the name so a second `drain start` never
    # overwrites the logs of already-running workers.
    logf="$LOG_DIR/worker-$(date '+%Y%m%d-%H%M%S')-$$-$i.log"
    { echo ""; echo "===== run started $(date '+%F %T')$mode_desc ====="; } >>"$logf"
    nohup bash "$DRAIN_SCRIPT" >>"$logf" 2>&1 &
    echo "started worker $i (pid $!$mode_desc, log $logf)"
  done
  if [ "$retry" = 1 ]; then
    echo "They'll reprocess failed tasks (one retry each), then exit. 'drain stop' to halt."
  elif [ "$persist" = 1 ]; then
    echo "They'll work through the queue, then wait for new jobs. 'drain stop' to halt."
  else
    echo "They'll work until the queue is empty, then exit. 'drain stop' to halt."
  fi
}

cmd_unfail() { # [project]
  local TASK="${TASK:-$(command -v task 2>/dev/null || echo /opt/homebrew/bin/task)}"
  local project="" a
  for a in "$@"; do
    case "$a" in
      "") ;;
      -*) die "unknown unfail option: $a (try: drain help)" ;;
      *) [ -z "$project" ] || die "unexpected argument: $a (try: drain help)"; project="$a" ;;
    esac
  done
  [ "$project" = "all" ] && project=""
  local filter="+drain-failed -ACTIVE -WAITING -BLOCKED -noauto"
  if [ -n "$project" ]; then filter="project:$project $filter"; fi
  # shellcheck disable=SC2086
  local tasks
  tasks=$("$TASK" $filter export 2>/dev/null || echo "[]")
  local count
  count=$(echo "$tasks" | jq 'length' 2>/dev/null || echo "0")
  if [ "$count" -eq 0 ]; then
    echo "No failed tasks found${project:+ in project '$project'}."
    return 0
  fi
  echo "Re-queueing $count failed task(s)${project:+ in project '$project'}:"
  echo "$tasks" | jq -r '.[] | "  \(.uuid) [\(.project // "?")] \(.description)"'
  echo
  echo "$tasks" | jq -r '.[].uuid' | while IFS= read -r uuid; do
    "$TASK" "$uuid" modify -drain-failed >/dev/null 2>&1 || echo "  WARN: failed to un-fail $uuid"
  done
  echo "Done. These tasks are now in the regular queue."
}

cmd_autoscale() { # [project] [--min N] [--max N]
  # Supervisor daemon: watches queue depth and scales workers up/down.
  need_script
  local project="" min_w="" max_w=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --min) [ $# -ge 2 ] || die "--min requires a value"; min_w="$2"; shift 2 ;;
      --max) [ $# -ge 2 ] || die "--max requires a value"; max_w="$2"; shift 2 ;;
      --min=*) min_w="${1#--min=}" ;;
      --max=*) max_w="${1#--max=}" ;;
      "") shift ;;
      -*) die "unknown autoscale option: $1 (try: drain help autoscale)" ;;
      *) [ -z "$project" ] || die "unexpected argument: $1"; project="$1"; shift ;;
    esac
  done
  [ "$project" = "all" ] && project=""
  min_w="${min_w:-${DRAIN_MIN_WORKERS:-1}}"
  max_w="${max_w:-${DRAIN_MAX_WORKERS:-8}}"
  [[ "$min_w" =~ ^[0-9]+$ ]] || die "--min must be a non-negative integer"
  [[ "$max_w" =~ ^[1-9][0-9]*$ ]] || die "--max must be a positive integer"
  [ "$min_w" -le "$max_w" ] || die "--min cannot exceed --max"

  local pidfile="$DRAIN_HOME/autoscale.pid"
  if [ -f "$pidfile" ] && kill -0 "$(cat "$pidfile")" 2>/dev/null; then
    die "autoscaler already running (pid $(cat "$pidfile")). 'drain autoscale-stop' first."
  fi

  mkdir -p "$LOG_DIR"
  [ -n "$project" ] && export PROJECT_FILTER="$project"
  export DRAIN_MIN_WORKERS="$min_w" DRAIN_MAX_WORKERS="$max_w"

  echo "starting autoscaler (min=$min_w max=$max_w${project:+ project=$project})..."
  nohup bash "$DRAIN_SCRIPT" autoscale >>"$LOG_DIR/autoscale.log" 2>&1 &
  echo $! > "$pidfile"
  echo "autoscaler running (pid $!). 'drain autoscale-stop' to halt."
}

cmd_autoscale_stop() {
  local pidfile="$DRAIN_HOME/autoscale.pid"
  if [ ! -f "$pidfile" ]; then echo "no autoscaler running."; return 0; fi
  local pid
  pid=$(cat "$pidfile")
  if kill -0 "$pid" 2>/dev/null; then
    kill -TERM "$pid" 2>/dev/null
    echo "autoscaler (pid $pid) stopping..."
  else
    echo "autoscaler pid $pid not running; cleaning up."
  fi
  rm -f "$pidfile"
}

cmd_stop() { # [N|all] [--force] -- default all
  local target="all" force=0 a
  for a in "$@"; do
    case "$a" in
      --force) force=1 ;;
      "") ;;
      all) target="all" ;;
      *)
        [[ "$a" =~ ^[1-9][0-9]*$ ]] || die "usage: drain stop [N|all] [--force]"
        [ "$target" = "all" ] || die "drain stop: only one positional argument allowed (got '$a' after '$target')"
        target="$a"
        ;;
    esac
  done
  if [ "$force" = 1 ] && [ "$target" != "all" ]; then
    die "drain stop --force: N is not compatible with --force (force stops all workers)"
  fi
  mkdir -p "$DRAIN_HOME"
  prune_stale_stops
  local running pids pid stopped=0
  running=$(worker_count)
  [ "$running" -gt 0 ] || { echo "no workers running."; return 0; }
  if [ "$force" = 1 ]; then
    pkill -TERM -f "(^|[^A-Za-z0-9_-])task-drain\.sh$"
    echo "force stop: TERM sent to all $running worker(s). In-flight tasks released to pending."
  elif [ "$target" = "all" ]; then
    touch "$STOP_FILE"
    echo "graceful stop requested for all $running worker(s). They'll exit after their current task."
  elif [ "$target" -ge "$running" ]; then
    touch "$STOP_FILE"
    echo "graceful stop requested for all $running worker(s) ($target >= running). They'll exit after their current task."
  else
    pids=$(worker_pids)
    while IFS= read -r pid; do
      [ -n "$pid" ] || continue
      [ "$stopped" -lt "$target" ] || break
      touch "$STOP_FILE.$pid"
      echo "graceful stop requested for worker pid $pid (finishes current task, then exits)."
      stopped=$((stopped+1))
    done <<<"$pids"
    echo "$stopped of $running worker(s) stopping. Check with: drain status"
  fi
  [ "$force" = 1 ] || echo "Check with: drain status"
}

cmd_kill() {
  if [ "$(worker_count)" -gt 0 ]; then
    pkill -TERM -f "(^|[^A-Za-z0-9_-])task-drain\.sh$"
    echo "TERM sent. In-flight tasks are released back to pending."
  else
    echo "no workers running."
  fi
}

cmd_resume() {
  rm -f "$STOP_FILE" "$DRAIN_HOME"/STOP.*
  echo "STOP cleared (global + per-worker). Start workers with: drain start [N] [project]"
}

cmd_logs() { # [-f]
  local follow=0 l
  [ "${1:-}" = "-f" ] && follow=1
  local logs=( "$LOG_DIR"/worker-*.log )
  [ -e "${logs[0]}" ] || die "no worker logs yet in $LOG_DIR"
  if [ "$follow" = 1 ]; then
    tail -f "${logs[@]}"
  else
    for l in "${logs[@]}"; do echo "--- $l"; tail -n 30 "$l"; done
  fi
}

cmd_projects() { # list configured project → repo mappings
  local conf="$HOME/.task-drain/repos.conf"
  local GIT_ROOT="${GIT_ROOT:-$HOME/git}"
  local DRAIN_SCRIPT="$SCRIPT_DIR/task-drain.sh"
  local TASK="${TASK:-$(command -v task 2>/dev/null || echo /opt/homebrew/bin/task)}"
  echo "Configured project → repo mappings:"
  echo
  # 1. repos.conf entries
  if [ -f "$conf" ]; then
    echo "  ~/.task-drain/repos.conf:"
    while IFS='=' read -r proj path; do
      case "$proj" in '' | \#*) continue ;; esac
      path="${path/#\~/$HOME}"
      path="${path//\$HOME/$HOME}"
      if [ -d "$path" ]; then
        echo "    $proj → $path"
      else
        echo "    $proj → $path (missing)"
      fi
    done <"$conf"
    echo
  fi
  # 2. Built-in table from task-drain.sh
  echo "  Built-in table (from task-drain.sh):"
  local projs=(attendeesync ncdlabs ncdlabs-assure ncdlabs-changepress ncdlabs-site-access-policies agentx innercircles gitseer meridian solfoundation)
  for proj in "${projs[@]}"; do
    local repo="$GIT_ROOT/$proj"
    case "$proj" in
      ncdlabs) repo="$GIT_ROOT/ncdlabs.com" ;;
      solfoundation) repo="$GIT_ROOT/wp-solfoundation-plugin" ;;
    esac
    if [ -d "$repo" ]; then
      echo "    $proj → $repo"
    else
      echo "    $proj → $repo (missing)"
    fi
  done
  echo
  # 3. Auto-detected from GIT_ROOT
  echo "  Auto-detected repos in $GIT_ROOT:"
  local found=0
  for dir in "$GIT_ROOT"/*/; do
    [ -d "$dir" ] || continue
    local name
    name=$(basename "$dir")
    # Skip if already listed above
    if [ -f "$conf" ] && grep -q "^${name}=" "$conf"; then continue; fi
    case " ${projs[*]} " in *" $name "*) continue ;; esac
    echo "    $name → $dir"
    found=1
  done
  [ "$found" = 0 ] && echo "    (none)"
  echo
  # 4. Projects with tasks
  echo "  Projects with pending tasks:"
  local tasks_projs
  tasks_projs=$("$TASK" _projects 2>/dev/null 2>/dev/null || echo "")
  if [ -n "$tasks_projs" ]; then
    for proj in $tasks_projs; do
      local count
      count=$("$TASK" "project:$proj" +PENDING -ACTIVE -WAITING count 2>/dev/null || echo "0")
      [ "$count" -gt 0 ] && echo "    $proj ($count pending)"
    done
  else
    echo "    (none)"
  fi
}

cmd_projects_merge() { # <destination> <source...>
  if [ $# -lt 2 ]; then
    die "usage: drain projects merge <destination> <source...> — needs at least 2 projects"
  fi
  local dest="$1"; shift
  local sources=("$@")
  # Safety: prevent merging a project into itself
  for src in "${sources[@]}"; do
    if [ "$src" = "$dest" ]; then
      die "cannot merge project '$dest' into itself"
    fi
  done
  local conf="$HOME/.task-drain/repos.conf"
  echo "Merging projects into '$dest':"
  echo "  destination: $dest"
  echo "  sources: ${sources[*]}"
  echo
  # Safety: confirm destination doesn't already have tasks (unless --force)
  local dest_count
  dest_count=$("$TASK" "project:$dest" +PENDING -ACTIVE -WAITING count 2>/dev/null || echo "0")
  local total_moved=0
  for src in "${sources[@]}"; do
    local src_count
    src_count=$("$TASK" "project:$src" +PENDING -ACTIVE -WAITING count 2>/dev/null || echo "0")
    if [ "$src_count" -eq 0 ]; then
      echo "  $src: no pending tasks, skipping"
      continue
    fi
    echo "  moving $src_count task(s) from $src → $dest ..."
    # Move pending, active, waiting, and completed tasks
    "$TASK" "project:$src" modify project:"$dest" 2>/dev/null || true
    total_moved=$((total_moved + src_count))
  done
  echo
  echo "Moved $total_moved total task(s) into '$dest'."
  # Update repos.conf if any source had a mapping
  if [ -f "$conf" ]; then
    local needs_update=0
    for src in "${sources[@]}"; do
      if grep -q "^${src}=" "$conf"; then
        needs_update=1
        break
      fi
    done
    if [ "$needs_update" = 1 ]; then
      echo
      echo "Note: some source projects have repo mappings in $conf."
      echo "Review and update: $conf"
    fi
  fi
  echo
  echo "Run 'task sync' to sync the changes."
}

cmd_help() {
  if [ $# -gt 0 ]; then
    help_for "$1"
  else
    awk 'NR==1{next} found{ if(/^#/||/^$/) print; else exit } /^#/{found=1; print}' "$0" | sed 's/^# //; s/^#//'
  fi
}

help_for() {
  case "$1" in
    status)
      cat <<'HELP'
drain status — show worker pool status

USAGE
  drain status [project] [-w|--watch] [--workers] [--verbose]

ARGUMENTS
  project          Limit to one project (e.g. drain status attendeesync)
                   'all' or no argument = all projects

OPTIONS
  -w, --watch      Live display, refreshes every DRAIN_WATCH_INTERVAL sec
  --workers        Live per-worker view: each worker's current task and
                   time-budget meter
  -v, --verbose    Show full task lists instead of the capped summary

EXAMPLES
  drain status
  drain status attendeesync
  drain status --watch
  drain status attendeesync --workers --verbose
HELP
      ;;
    start)
      cat <<'HELP'
drain start — start background workers

USAGE
  drain start [N] [project|all] [--failed] [--persist]

ARGUMENTS
  N                Number of workers to start (default 2, max 8)
  project          Limit to one project (e.g. drain start 3 attendeesync)
                   'all' or no argument = take tasks from any project

OPTIONS
  --failed         Reprocess drain-failed tasks instead of the regular queue
  --persist        Workers wait for new jobs after the queue empties
                   instead of exiting

EXAMPLES
  drain start
  drain start 4
  drain start 3 attendeesync
  drain start 2 --failed
  drain start 2 attendeesync --failed
  drain start 2 --persist
  drain start 2 attendeesync --persist

Workers loop: sync -> pick highest-urgency eligible task -> claim it ->
run `opencode run` -> verify -> repeat until queue is empty, then exit
(or wait for new jobs if --persist).
HELP
      ;;
    unfail)
      cat <<'HELP'
drain unfail — remove drain-failed tag from failed tasks

USAGE
  drain unfail [project]

ARGUMENTS
  project          Limit to one project (e.g. drain unfail attendeesync)
                   No argument = all projects

EXAMPLES
  drain unfail
  drain unfail attendeesync

Removes the drain-failed tag from matching tasks, returning them to the
regular queue. Workers (persistent or autoscaled) will pick them up
on their next poll.
HELP
      ;;
    stop)
      cat <<'HELP'
drain stop — graceful stop

USAGE
  drain stop [N|all] [--force]

ARGUMENTS
  N                Stop N workers (newest first). N >= running stops all.
  all              Stop all workers (default)

OPTIONS
  --force          Immediate stop (TERM mid-task, like drain kill)

EXAMPLES
  drain stop
  drain stop all
  drain stop 2
  drain stop --force

With no --force: workers finish their current task, pick up nothing new,
then exit. With --force: workers are killed immediately; in-flight tasks
are released back to pending.
HELP
      ;;
    kill)
      cat <<'HELP'
drain kill — immediate stop

USAGE
  drain kill

TERM workers mid-task. In-flight tasks are released back to pending.
Same as `drain stop --force`.
HELP
      ;;
    autoscale)
      cat <<'HELP'
drain autoscale — supervisor daemon that scales workers to queue depth

USAGE
  drain autoscale [project] [--min N] [--max N]

ARGUMENTS
  project          Limit to one project (e.g. drain autoscale attendeesync)
                   'all' or no argument = all projects

OPTIONS
  --min N          Minimum workers to keep running (default 1)
  --max N          Maximum workers to start (default 8)

ENVIRONMENT
  DRAIN_MIN_WORKERS         Default for --min (default 1)
  DRAIN_MAX_WORKERS         Default for --max (default 8)
  DRAIN_AUTOSCALE_INTERVAL  Seconds between checks (default 30)
  DRAIN_TASKS_PER_WORKER    Eligible tasks per worker (default 2)

EXAMPLES
  drain autoscale
  drain autoscale attendeesync
  drain autoscale --min 2 --max 6
  drain autoscale attendeesync --min 0 --max 10

The autoscaler counts eligible tasks, computes desired workers as
ceil(eligible / DRAIN_TASKS_PER_WORKER), clamps to [--min, --max], then
starts or stops workers to match. If eligible=0 and min=0, it scales to
zero. Stop with: drain autoscale-stop
HELP
      ;;
    autoscale-stop)
      cat <<'HELP'
drain autoscale-stop — stop the autoscaler

USAGE
  drain autoscale-stop

Stops the autoscaler daemon. Workers already running are NOT affected —
they keep working until the queue is empty or they are stopped.
HELP
      ;;
    resume)
      cat <<'HELP'
drain resume — clear the kill switch

USAGE
  drain resume

Removes ~/.task-drain/STOP and all per-worker STOP.<pid> files. Does not
start workers — use `drain start` to launch them.
HELP
      ;;
    logs)
      cat <<'HELP'
drain logs — view worker logs

USAGE
  drain logs [-f]

OPTIONS
  -f               Follow (tail -f) all worker logs

Logs are at ~/.task-drain/logs/worker-<timestamp>-<pid>-N.log
HELP
      ;;
    projects)
      cat <<'HELP'
drain projects — list configured project → repo mappings

USAGE
  drain projects

Shows all project → repo mappings from:
  1. ~/.task-drain/repos.conf (primary)
  2. Built-in table in task-drain.sh
  3. Auto-detected repos in $GIT_ROOT
  4. Projects with pending tasks
HELP
      ;;
    projects-merge)
      cat <<'HELP'
drain projects merge — merge source projects into a destination

USAGE
  drain projects merge <destination> <source...>

Moves all tasks from each source project into the destination project.
At least 2 projects required (1 destination + 1+ sources).

EXAMPLES
  drain projects merge myproject old-project-a old-project-b
  drain projects merge solfoundation solfoundation.brevo-cleanup

After merging, run: task sync
HELP
      ;;
    docs)
      cat <<'HELP'
drain docs — extended documentation

USAGE
  drain docs

Shows detailed docs on pickup rules, tags (noauto, drain-failed,
drain-claimed), retrying failed tasks, the agent prompt, stopping, and
safety dials.
HELP
      ;;
    help)
      cat <<'HELP'
drain help — show help

USAGE
  drain help              List all commands
  drain help <command>     Detailed help for one command
  drain <command> help    Same as above

EXAMPLES
  drain help
  drain help autoscale
  drain autoscale help
HELP
      ;;
    *)
      die "no help for unknown command: $1"
      ;;
  esac
}

cmd_docs() {
  cat <<'DOCS_EOF'
DRAIN -- autonomous Taskwarrior queue workers
============================================

WHAT IT DOES
  Each worker loops: sync -> pick the highest-urgency eligible task ->
  claim it -> run `opencode run` on it -> verify -> repeat until the
  queue is empty, then exits.

WHAT GETS PICKED UP
  Nothing special is required. Pickup is OPT-OUT: any task is eligible
  unless it is:
    - already active (started by someone or something)
    - waiting (scheduled for a future date)
    - blocked (has an unmet dependency)
    - tagged noauto        (your opt-out)
    - tagged drain-failed  (a worker already tried and couldn't finish it)
  Among eligible tasks, highest urgency goes first. Limit to one project:
    drain start 2 attendeesync

TAGS
  noauto
    Tag a task and drain workers will never touch it. Use for tasks that
    need you, interactive-only work, or anything you don't want a free
    model grinding on unattended:
      task <uuid> modify +noauto
  drain-failed
    Set automatically when a worker attempt ends without the task being
    completed (agent failed it, crashed, timed out, or finished nothing).
    Regular workers never retry these. To give them another shot, either
    re-queue (a normal worker picks it up):
      task <uuid> modify -drain-failed
    or retry directly without untagging:
      drain start 2 --failed                (all projects)
      drain start 2 attendeesync --failed   (one project)
    A --failed retry that fails again keeps drain-failed; each task gets
    at most one retry per --failed run, so nothing loops forever.
    Everything failed is listed under `drain status` ("needs human review").
  drain-claimed
    Set automatically while a worker owns a task. Don't set it by hand.
    If a worker dies mid-task, its claim is auto-released after 4 hours.
    Only worker claims are ever released -- your interactive sessions'
    active tasks are never touched.

RETRYING FAILED TASKS
  drain start [N] [project] --failed
    Spins up workers that reprocess drain-failed tasks instead of the
    regular queue. The failed set is snapshotted when each worker starts;
    every failed task gets at most one retry per run, so a task that fails
    again can't loop -- it keeps drain-failed for the next explicit retry.
    Combine with a project:  drain start 2 attendeesync --failed

WHAT THE AGENT IS TOLD
  Every worker hands its task to `opencode run` with a prompt enforcing:
    - Taskwarrior is the only system of record. Sync at session start,
      after every change, and at session end. Never work offline. Never
      change the sync client ID. Reference tasks by UUID, never short IDs.
    - Authority: design, security, product, and public-facing decisions
      belong to the project owner (see DRAIN_OWNER in task-drain.sh).
      If the task needs human judgment, credentials it lacks, a
      legal/compliance declaration, or anything public or irreversible,
      the agent must annotate what's needed and FAIL the task -- never
      decide on its own.
    - Completion contract: verify for real (build, tests, or the task's
      own acceptance criteria). Only then `task <uuid> done`. Partial or
      unverified work is failed, never marked done.

STOPPING
  drain stop        graceful all: no new pickups; in-flight tasks finish, workers exit
  drain stop all    same as bare 'drain stop'
  drain stop N      graceful: stop N workers (newest first); each finishes its
                    current task, then exits. N >= running stops all.
  drain stop --force  immediate: TERM workers mid-task; claims released to pending
                    (same as drain kill, but via the stop command)
  drain kill    immediate: workers die mid-task; claims released to pending
  drain resume  clear the STOP file (doesn't start workers)

LOGS
  ~/.task-drain/logs/worker-<timestamp>-<pid>-N.log      drain logs [-f]

VIEWS
  drain status              queue dashboard (one snapshot)
  drain status -w           same, live (q quits, DRAIN_WATCH_INTERVAL=5)
  drain status --workers    live per-worker view: each worker's current
                            task + time-budget meter (q quits). With a
                            project, other projects are dimmed:
                              drain status attendeesync --workers

SAFETY DIALS (env vars, or edit at the top of task-drain.sh)
  DRAIN_SKIP_PERMISSIONS=1      : adds --dangerously-skip-permissions to
      opencode run flags. Without it, unattended runs stall on the first
      approval prompt. With it, the agent can edit, run, and push without
      asking. This is the main risk dial -- only enable if you trust the
      autonomous worker to operate without human approval.
  DRAIN_MODEL                  : model for worker runs
                                  (default opencode-go/longcat-2.5-preview-free)
  STALE_AFTER_SEC=14400  : release worker claims older than 4 hours
  TASK_TIMEOUT_SEC=14400 : per-task wall clock (needs `gtimeout`)
DOCS_EOF
}

# Second-level help: drain <cmd> help
if [ $# -ge 2 ]; then
  case "$2" in
    help|--help|-h)
      cmd_help "$1"
      exit 0
      ;;
  esac
fi

case "${1:-}" in
  "") cmd_help ;;
  status) shift; cmd_status "$@" ;;
  docs) cmd_docs ;;
  start)  shift; cmd_start "$@" ;;
  stop)   shift; cmd_stop "$@" ;;
  kill)   cmd_kill ;;
  autoscale) shift; cmd_autoscale "$@" ;;
  autoscale-stop) cmd_autoscale_stop ;;
  unfail)
    shift
    if [ $# -gt 0 ] && [ "$1" = "help" ]; then
      help_for unfail
    else
      cmd_unfail "$@"
    fi
    ;;
  resume) cmd_resume ;;
  logs)   shift; cmd_logs "${1:-}" ;;
  projects)
    shift
    if [ $# -gt 0 ] && [ "$1" = "merge" ]; then
      shift
      if [ $# -gt 0 ] && [ "$1" = "help" ]; then
        help_for projects-merge
      else
        cmd_projects_merge "$@"
      fi
    elif [ $# -gt 0 ] && [ "$1" = "help" ]; then
      help_for projects
    else
      cmd_projects "$@"
    fi
    ;;
  help|--help|-h)
    if [ $# -ge 2 ] && [ -n "$2" ]; then cmd_help "$2"; else cmd_help; fi
    ;;
  *)      die "unknown command: $1 (try: drain help)" ;;
esac
