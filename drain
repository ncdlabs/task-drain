#!/usr/bin/env bash
export PATH="${PATH:-/usr/bin:/bin}:$HOME/.opencode/bin:$HOME/bin:/opt/homebrew/bin:/usr/local/bin"
#
# drain -- CLI for the task-drain autonomous worker pool.
# Worker logic lives in the adjacent task-drain.sh; this is the human interface.
#
#   drain                show this help
#   drain status [project] [-w|--watch] [--workers] [--verbose]
#                        show status (workers, kill switch, queue),
#                        optionally scoped to one project; -w keeps a
#                        live display (q quits, DRAIN_WATCH_INTERVAL=5);
#                        --workers shows a live per-worker view instead:
#                        each worker's current task + time-budget meter;
#                        --verbose (or DRAIN_VERBOSE=1) shows full lists
#                        instead of the capped summary view
#   drain docs           how pickup, tags, and the kill switch work
#   drain start [N] [project|all] [--failed] [--persist]
#                        start N background workers (default 2, max 8),
#                        optionally limited to one project, e.g.:
#                          drain start 3 attendeesync
#                        'all' (or no project) = take tasks from any project.
#                        --failed = reprocess drain-failed tasks instead of
#                        the regular queue, e.g.:
#                          drain start 2 attendeesync --failed
#                        --persist = workers wait for new jobs after the queue
#                        empties instead of exiting, e.g.:
#                          drain start 2 attendeesync --persist
#   drain stop [N|all]   graceful stop: workers finish their current task,
#                        pick up nothing new, then exit.
#                        No arg (or 'all') = stop ALL workers.
#                        N = stop N workers (newest first).
#                        --force = immediate stop (TERM mid-task, like drain kill)
#   drain kill           immediate stop: TERM workers mid-task (in-flight
#                        tasks are released back to pending, cleanly)
#   drain autoscale [project] [--min N] [--max N]
#                        supervisor daemon: watches queue depth and scales
#                        workers up/down automatically. Defaults: --min 1,
#                        --max 8. Env: DRAIN_MIN_WORKERS, DRAIN_MAX_WORKERS,
#                        DRAIN_AUTOSCALE_INTERVAL (sec, default 30),
#                        DRAIN_TASKS_PER_WORKER (default 2).
#   drain autoscale-stop stop the autoscaler (workers keep running)
#   drain unfail [project] remove drain-failed tag from failed tasks,
#                        returning them to the regular queue
#   drain resume         clear the STOP file (does not start workers)
#   drain logs [-f]      tail worker logs (follow with -f)
#   drain history [--limit N]
#                        show last N processed tasks (default 20)
#   drain pr list [--json]
#                        list open PRs created by drain agents
#   drain projects       list configured project → repo mappings
#   drain projects merge <destination> <source...>
#                        merge source projects into destination (moves all tasks)
#   drain config show [--json]
#                        effective configuration with provenance (see docs/configuration.md)
#   drain config validate
#                        validate the effective configuration (nonzero exit on failure)
#   drain config path  display the active configuration file path
#   drain config defaults
#                        print a complete commented template (modifies nothing)
#   drain config init  create the default template (mode 600) only when absent
#   drain --config PATH <cmd>
#                        use PATH instead of ~/.task-drain/config.yaml (also DRAIN_CONFIG)
#   drain help
#
# Workers log to ~/.task-drain/logs/worker-<timestamp>-<pid>-N.log.
#
set -euo pipefail

# Resolve symlinks so the script finds its siblings even when invoked
# through ~/bin/drain -> repo/bin/drain. macOS readlink lacks -f.
resolve_symlink() {
  local path="$1" target
  while [ -L "$path" ]; do
    target=$(readlink "$path")
    if [[ "$target" != /* ]]; then
      target="$(dirname -- "$path")/$target"
    fi
    path="$target"
  done
  printf '%s\n' "$path"
}

SCRIPT_PATH="$(resolve_symlink "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)"
DRAIN_SCRIPT="$SCRIPT_DIR/task-drain.sh"
DRAIN_HOME="$HOME/.task-drain"
LOG_DIR="$DRAIN_HOME/logs"
STOP_FILE="$DRAIN_HOME/STOP"
TASK="${TASK:-$(command -v task || true)}"

# Source shared worker detection functions
# shellcheck source=lib/worker-detect.sh
source "$SCRIPT_DIR/lib/worker-detect.sh"
# shellcheck source=lib/supervisor.sh
source "$SCRIPT_DIR/lib/supervisor.sh"

# Source config loader (YAML)
# shellcheck source=lib/config.sh
source "$SCRIPT_DIR/lib/config.sh"

die() { echo "drain: $*" >&2; exit 1; }

# Remote execution support.
# If DRAIN_REMOTE_EXEC is set (we're already on the remote), skip.
# Otherwise, check --remote/--local flags and default_remote config.
DRAIN_TARGET_REMOTE=""
DRAIN_FORCE_LOCAL=""

# Parse --remote/--local/--config before the command (global options).
# --config PATH overrides DRAIN_CONFIG for every subcommand consistently.
_DRAIN_ARGS=()
for _a in "$@"; do
	case "$_a" in
	--remote) _DRAIN_REMOTE_NEXT=1 ;;
	--remote=*) DRAIN_TARGET_REMOTE="${_a#--remote=}" ;;
	--local) DRAIN_FORCE_LOCAL=1 ;;
	--config) _DRAIN_CONFIG_NEXT=1 ;;
	--config=*) export DRAIN_CONFIG="${_a#--config=}" ;;
	*)
		if [ -n "${_DRAIN_REMOTE_NEXT:-}" ]; then
			DRAIN_TARGET_REMOTE="$_a"
			_DRAIN_REMOTE_NEXT=""
		elif [ -n "${_DRAIN_CONFIG_NEXT:-}" ]; then
			export DRAIN_CONFIG="$_a"
			_DRAIN_CONFIG_NEXT=""
		else
			_DRAIN_ARGS+=("$_a")
		fi
		;;
	esac
done
if [ -n "${_DRAIN_REMOTE_NEXT:-}" ]; then
	die "--remote requires a name"
fi
if [ -n "${_DRAIN_CONFIG_NEXT:-}" ]; then
	die "--config requires a path"
fi
set -- "${_DRAIN_ARGS[@]}"
# --config is honored for remote dispatch as well: the config file selects
# default_remote/remotes.* consistently across all subcommands.

# Resolve target remote: explicit flag > config default > local
if [ -z "$DRAIN_FORCE_LOCAL" ] && [ -z "${DRAIN_REMOTE_EXEC:-}" ]; then
	if [ -z "$DRAIN_TARGET_REMOTE" ]; then
		DRAIN_TARGET_REMOTE=$(config_get default_remote "")
	fi
fi

# If targeting a remote, exec via SSH helper
if [ -n "$DRAIN_TARGET_REMOTE" ] && [ -z "${DRAIN_REMOTE_EXEC:-}" ]; then
	_ssh=$(config_get "remotes.${DRAIN_TARGET_REMOTE}.ssh" "")
	[ -n "$_ssh" ] || die "remote '$DRAIN_TARGET_REMOTE' not configured (remotes.${DRAIN_TARGET_REMOTE}.ssh)"
	# Prevent recursion on the remote
	exec env DRAIN_REMOTE_EXEC=1 $_ssh "bash ~/bin/drain $*"
fi

need_script() { [ -f "$DRAIN_SCRIPT" ] || die "worker script not found: $DRAIN_SCRIPT"; }

# Fail-closed single-host guard for the CLI. When worker.primary_host (or
# DRAIN_PRIMARY_HOST) is configured, `drain start` and `drain autoscale`
# refuse on other hosts unless DRAIN_ALLOW_OTHER_HOST=1. Unset = no
# enforcement (see docs/architecture.md: true cross-host prevention needs
# an external coordination primitive).
check_cli_primary_host() { # $1 = command name
  local primary me
  if ! drain_config_valid >/dev/null 2>&1; then
    drain_config_valid >&2 || true
    die "$1 refused: invalid configuration (run: drain config validate)"
  fi
  primary="${DRAIN_PRIMARY_HOST:-}"
  if [ -z "$primary" ]; then primary=$(drain_config_value worker.primary_host 2>/dev/null || true); fi
  [ -n "$primary" ] || return 0
  me=$(hostname -s 2>/dev/null || hostname)
  if ! python3 "$SCRIPT_DIR/lib/drain-config.py" match-host --configured "$primary" --actual "$me" 2>/dev/null; then
    if [ "${DRAIN_ALLOW_OTHER_HOST:-0}" = "1" ]; then
      echo "drain: WARNING: $1 on $me although primary host is $primary (DRAIN_ALLOW_OTHER_HOST=1 override)" >&2
      return 0
    fi
    die "$1 refused on $me: primary autonomous host is $primary (set DRAIN_ALLOW_OTHER_HOST=1 to override explicitly)"
  fi
}

worker_pids() {
  # Use shared worker detection from lib/worker-detect.sh
  drain_worker_pids
}

worker_count() {
  local ps_out
  ps_out=$(worker_pids)
  if [ -z "$ps_out" ]; then echo 0; else printf '%s\n' "$ps_out" | wc -l | tr -d ' '; fi
}

prune_stale_stops() {
  # Drop per-worker STOP.<pid> files whose worker is already gone.
  local f pid alive
  alive=$(worker_pids)
  for f in "$DRAIN_HOME"/STOP.*; do
    [ -e "$f" ] || continue
    pid=${f##*.}
    [[ "$pid" =~ ^[0-9]+$ ]] || continue
    if ! printf '%s\n' "$alive" | grep -qx "$pid"; then rm -f "$f"; fi
  done
}

cmd_status() { # [project] [-w|--watch] [--workers] [--verbose]
  need_script
  local project="" watch=0 workers=0 verbose=0 a
  for a in "$@"; do
    case "$a" in
      -w|--watch) watch=1 ;;
      --workers) workers=1 ;;
      -v|--verbose) verbose=1 ;;
      -*) die "unknown status option: $a (try: drain help)" ;;
      *) [ -z "$project" ] || die "unexpected argument: $a (try: drain help)"; project="$a" ;;
    esac
  done
  [ "$project" = "all" ] && project=""
  if [ "$workers" = 1 ]; then
    PROJECT_FILTER="$project" bash "$DRAIN_SCRIPT" workers
  elif [ "$watch" = 1 ]; then
    if [ "$verbose" = 1 ]; then export DRAIN_VERBOSE=1; fi
    PROJECT_FILTER="$project" bash "$DRAIN_SCRIPT" watch
  else
    if [ "$verbose" = 1 ]; then export DRAIN_VERBOSE=1; fi
    PROJECT_FILTER="$project" bash "$DRAIN_SCRIPT" status
  fi
}

cmd_start() { # [N] [project|all] [--failed] [--persist] [--autonomous]
  need_script
  check_cli_primary_host "drain start"
  local n="" project="" retry=0 persist=0 autonomous=0 running i logf a
  for a in "$@"; do
    case "$a" in
      "") ;;
      --failed) retry=1 ;;
      --persist) persist=1 ;;
      --autonomous) autonomous=1 ;;
      *)
        if [[ "$a" =~ ^[0-9]+$ ]] && [ -z "$n" ]; then n="$a"
        elif [ -z "$project" ]; then project="$a"
        else die "unexpected argument: $a (try: drain help)"; fi ;;
    esac
  done
  [ -n "$n" ] || n=2
  [[ "$n" =~ ^[1-9][0-9]*$ ]] || die "N must be a positive integer"
  [ "$n" -le 8 ] || die "max 8 workers"
  [ "$project" = "all" ] && project=""
  if [ "$autonomous" = 1 ] && supervisor_is_live; then
    die "Supervisor already running; use autoscale-stop before changing mode/project"
  fi
  mkdir -p "$LOG_DIR"
  if [ -e "$STOP_FILE" ]; then rm -f "$STOP_FILE"; echo "cleared STOP file."; fi
  prune_stale_stops
  running=$(worker_count)
  if [ "$running" -gt 0 ]; then echo "note: $running worker(s) already running; starting $n more."; fi
  export PROJECT_FILTER="$project"
  [ "$retry" = 1 ] && export DRAIN_RETRY_FAILED=1
  [ "$persist" = 1 ] && export DRAIN_PERSIST=1
  [ "$autonomous" = 1 ] && export DRAIN_AUTONOMOUS=1
  local mode_desc=""
  [ -n "$project" ] && mode_desc=" [project=$project]"
  [ "$retry" = 1 ] && mode_desc="$mode_desc [retrying failed]"
  [ "$persist" = 1 ] && mode_desc="$mode_desc [persist]"
  [ "$autonomous" = 1 ] && mode_desc="$mode_desc [autonomous]"
  for i in $(seq 1 "$n"); do
    # Timestamp + CLI pid in the name so a second `drain start` never
    # overwrites the logs of already-running workers.
    logf="$LOG_DIR/worker-$(date '+%Y%m%d-%H%M%S')-$$-$i.log"
    { echo ""; echo "===== run started $(date '+%F %T')$mode_desc ====="; } >>"$logf"
    nohup bash "$DRAIN_SCRIPT" >>"$logf" 2>&1 &
    echo "started worker $i (pid $!$mode_desc, log $logf)"
  done
  if [ "$retry" = 1 ]; then
    echo "They'll reprocess failed tasks (one retry each), then exit. 'drain stop' to halt."
  elif [ "$persist" = 1 ]; then
    echo "They'll work through the queue, then wait for new jobs. 'drain stop' to halt."
  else
    echo "They'll work until the queue is empty, then exit. 'drain stop' to halt."
  fi
  if [ "$autonomous" = 1 ]; then
    echo "Autonomous mode: opt-in pickup (tasks need +auto tag)."
    if supervisor_is_live; then
      echo "autoscaler already running (pid $(supervisor_registered_pid))."
    else
      cmd_autoscale "${project:-all}"
    fi
  fi
}

cmd_unfail() { # [project] [--dry-run]
  local project="" preview=0 a failed=0 uuid tasks
  for a in "$@"; do
    case "$a" in --dry-run) preview=1 ;; -*) die "unknown unfail option: $a" ;; *) [ -z "$project" ] || die "unexpected argument: $a"; project="$a" ;; esac
  done
  [ "$project" != all ] || project=""
  local filter=(status:pending)
  [ -z "$project" ] || filter+=("project:$project")
  "$TASK" sync || die "Sync failed before unfail; no changes made"
  tasks=$("$TASK" "${filter[@]}" export | jq '[.[] | select((.tags // []) | index("drain-failed"))]') || die "Failed to query tasks"
  echo "$tasks" | jq -r '.[] | "\(.uuid) [\(.project // "?")] \(.description)"'
  [ "$preview" = 0 ] || return 0
  while IFS= read -r uuid; do
    [ -n "$uuid" ] || continue
    "$TASK" "$uuid" modify -drain-failed || failed=1
  done < <(echo "$tasks" | jq -r '.[].uuid')
  "$TASK" sync || die "Local changes applied; sync failed. Inspect before retrying"
  [ "$failed" = 0 ] || die "Some tasks could not be requeued; inspect listed UUIDs"
}

cmd_autoscale() { # [project] [--min N] [--max N]
  # Supervisor daemon: watches queue depth and scales workers up/down.
  need_script
  check_cli_primary_host "drain autoscale"
  local project="" min_w="" max_w=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --min) [ $# -ge 2 ] || die "--min requires a value"; min_w="$2"; shift 2 ;;
      --max) [ $# -ge 2 ] || die "--max requires a value"; max_w="$2"; shift 2 ;;
      --min=*) min_w="${1#--min=}"; shift ;;
      --max=*) max_w="${1#--max=}"; shift ;;
      "") shift ;;
      -*) die "unknown autoscale option: $1 (try: drain help autoscale)" ;;
      *) [ -z "$project" ] || die "unexpected argument: $1"; project="$1"; shift ;;
    esac
  done
  [ "$project" = "all" ] && project=""
  if [ -z "$min_w" ]; then min_w=$(drain_config_value supervisor.min_workers); fi
  if [ -z "$max_w" ]; then max_w=$(drain_config_value supervisor.max_workers); fi
  if ! python3 "$SCRIPT_DIR/lib/drain-config.py" validate --set "supervisor.min_workers=$min_w" --set "supervisor.max_workers=$max_w" >/dev/null 2>&1; then
    python3 "$SCRIPT_DIR/lib/drain-config.py" validate --set "supervisor.min_workers=$min_w" --set "supervisor.max_workers=$max_w" >&2 || true
    die "invalid --min/--max (see errors above; run: drain config validate)"
  fi
  [ "$min_w" -le "$max_w" ] || die "--min cannot exceed --max"

  local pidfile
  pidfile="$(supervisor_pidfile)"
  # Serialize the check-and-launch window so two concurrent invocations
  # cannot both pass the liveness check and start duplicate supervisors.
  # One short retry covers the millisecond window where a legitimate
  # starter holds the mutex between its check and its pidfile write.
  if ! supervisor_acquire_launch_lock; then
    sleep 2
    if ! supervisor_acquire_launch_lock; then
      if supervisor_is_live; then
        die "autoscaler already running (pid $(supervisor_registered_pid)). 'drain autoscale-stop' first."
      fi
      die "another autoscale startup is in progress; retry in a few seconds."
    fi
  fi
  if supervisor_is_live; then
    supervisor_release_launch_lock
    die "autoscaler already running (pid $(supervisor_registered_pid)). 'drain autoscale-stop' first."
  fi
  # Stale pidfile (dead PID, PID reuse by an unrelated process, or garbage):
  # never blocks startup. Remove only when provably not a live supervisor.
  if [ -f "$pidfile" ]; then
    rm -f "$pidfile"
    echo "note: removed stale supervisor state."
  fi

  mkdir -p "$LOG_DIR"
  export PROJECT_FILTER="$project"
  export DRAIN_MIN_WORKERS="$min_w" DRAIN_MAX_WORKERS="$max_w"

  [ ! -e "$STOP_FILE" ] || { supervisor_release_launch_lock; die "STOP is set; run drain resume before starting a supervisor"; }
  echo "starting autoscaler (min=$min_w max=$max_w${project:+ project=$project})..."
  nohup bash "$DRAIN_SCRIPT" autoscale >>"$LOG_DIR/autoscale.log" 2>&1 &
  echo $! > "$pidfile"
  echo "autoscaler running (pid $!). 'drain autoscale-stop' to halt."
  supervisor_release_launch_lock
}

cmd_autoscale_stop() {
  local pidfile="$DRAIN_HOME/autoscale.pid"
  if [ ! -f "$pidfile" ]; then echo "no autoscaler running."; return 0; fi
  stop_autoscaler
}

stop_autoscaler() {
  # TERM only the verified supervisor: the pidfile PID must be alive AND
  # its command line must match the supervisor pattern. A stale pidfile
  # (dead PID, garbage, or a reused PID now owned by an unrelated process)
  # never authorizes a kill — it is cleaned up without signaling anyone.
  # The pidfile is removed only when it still names the PID we stopped
  # (or a provably non-supervisor value), never a successor's file.
  local pidfile pid attempt
  pidfile="$(supervisor_pidfile)"
  [ -f "$pidfile" ] || return 0
  if ! supervisor_is_live; then
    pid=$(cat "$pidfile" 2>/dev/null | tr -d ' \t\n' || true)
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && ! supervisor_cmd_matches "$pid"; then
      echo "stale supervisor state (pid $pid is not a supervisor); leaving that process alone." >&2
    fi
    rm -f "$pidfile"
    return 0
  fi
  pid=$(supervisor_registered_pid)
  kill -TERM "$pid" 2>/dev/null || true
  echo "autoscaler (pid $pid) stopping."
  for attempt in $(seq 1 10); do
    kill -0 "$pid" 2>/dev/null || break
    sleep 1
  done
  if kill -0 "$pid" 2>/dev/null; then
    echo "autoscaler (pid $pid) still running after TERM; not escalating automatically. Inspect before 'kill -KILL $pid'." >&2
  fi
  supervisor_remove_pidfile_if "$pid" || true
}

signal_workers() {
  local pid attempt
  local pids
  pids=$(worker_pids)
  for pid in $pids; do kill -TERM "$pid" 2>/dev/null || true; done
  for attempt in $(seq 1 10); do
    local alive=0
    for pid in $pids; do kill -0 "$pid" 2>/dev/null && alive=1; done
    [ "$alive" = 1 ] || return 0
    sleep 1
  done
  echo "Some workers still running after TERM; inspect before releasing claims" >&2
  return 1
}
cmd_stop() { # [N|all] [--force] -- default all
  local target="all" force=0 a
  for a in "$@"; do
    case "$a" in
      --force) force=1 ;;
      "") ;;
      all) target="all" ;;
      *)
        [[ "$a" =~ ^[1-9][0-9]*$ ]] || die "usage: drain stop [N|all] [--force]"
        [ "$target" = "all" ] || die "drain stop: only one positional argument allowed (got '$a' after '$target')"
        target="$a"
        ;;
    esac
  done
  if [ "$force" = 1 ] && [ "$target" != "all" ]; then
    die "drain stop --force: N is not compatible with --force (force stops all workers)"
  fi
  mkdir -p "$DRAIN_HOME"
  prune_stale_stops
  local running pids pid stopped=0
  running=$(worker_count)
  if [ "$target" = all ] || [ "$force" = 1 ]; then
    touch "$STOP_FILE"
    stop_autoscaler
  fi
  [ "$running" -gt 0 ] || { echo "no workers running."; return 0; }
  if [ "$force" = 1 ]; then
    signal_workers
    stop_autoscaler
    echo "force stop: TERM sent to all $running worker(s). In-flight tasks released to pending."
  elif [ "$target" = "all" ]; then
    touch "$STOP_FILE"
    echo "graceful stop requested for all $running worker(s). They'll exit after their current task."
  elif [ "$target" -ge "$running" ]; then
    touch "$STOP_FILE"
    echo "graceful stop requested for all $running worker(s) ($target >= running). They'll exit after their current task."
  else
    pids=$(worker_pids)
    while IFS= read -r pid; do
      [ -n "$pid" ] || continue
      [ "$stopped" -lt "$target" ] || break
      touch "$STOP_FILE.$pid"
      echo "graceful stop requested for worker pid $pid (finishes current task, then exits)."
      stopped=$((stopped+1))
    done <<<"$pids"
    echo "$stopped of $running worker(s) stopping. Check with: drain status"
  fi
  [ "$force" = 1 ] || echo "Check with: drain status"
}

cmd_kill() {
  if [ "$(worker_count)" -gt 0 ]; then
    signal_workers
    echo "TERM sent. In-flight tasks are released back to pending."
  else
    echo "no workers running."
  fi
  stop_autoscaler
}

cmd_resume() {
  rm -f "$STOP_FILE" "$DRAIN_HOME"/STOP.*
  echo "STOP cleared (global + per-worker). Start workers with: drain start [N] [project]"
}

cmd_logs() { # [-f]
  local follow=0 l
  [ "${1:-}" = "-f" ] && follow=1
  local logs=( "$LOG_DIR"/worker-*.log )
  [ -e "${logs[0]}" ] || die "no worker logs yet in $LOG_DIR"
  if [ "$follow" = 1 ]; then
    tail -f "${logs[@]}"
  else
    for l in "${logs[@]}"; do echo "--- $l"; tail -n 30 "$l"; done
  fi
}

cmd_history() { # [--limit N] -- show recently processed drain tasks
  need_script
  local limit="${DRAIN_HISTORY_LIMIT:-20}"
  local args=("$@")
  while [ $# -gt 0 ]; do
    case "$1" in
      --limit) [ $# -ge 2 ] || die "--limit requires a value"; limit="$2"; shift 2 ;;
      --limit=*) limit="${1#--limit=}"; shift ;;
      -v|--verbose) shift ;; # accepted for consistency, no effect
      -*) die "unknown history option: $1 (try: drain help)" ;;
      *) die "unexpected argument: $1 (try: drain help)" ;;
    esac
  done
  PROJECT_FILTER="" DRAIN_HISTORY_LIMIT="$limit" bash "$DRAIN_SCRIPT" history "${args[@]}"
}

cmd_pr_list() { # [--json] -- list open PRs created by drain agents
	need_script
	PROJECT_FILTER="${PROJECT_FILTER:-}" bash "$DRAIN_SCRIPT" pr-list "$@"
}

cmd_projects() { # list configured project → repo mappings
  local conf="$HOME/.task-drain/repos.conf"
  local GIT_ROOT="${GIT_ROOT:-$HOME/git}"
  local DRAIN_SCRIPT="$SCRIPT_DIR/task-drain.sh"
  local TASK="${TASK:-$(command -v task 2>/dev/null || echo /opt/homebrew/bin/task)}"
  echo "Configured project → repo mappings (source inventory; effective mappings below):"
  echo
  # 1. repos.conf entries
  if [ -f "$conf" ]; then
    echo "  ~/.task-drain/repos.conf:"
    while IFS='=' read -r proj path; do
      case "$proj" in '' | \#*) continue ;; esac
      path="${path/#\~/$HOME}"
      path="${path//\$HOME/$HOME}"
      if [ -d "$path" ]; then
        echo "    $proj → $path"
      else
        echo "    $proj → $path (missing)"
      fi
    done <"$conf"
    echo
  fi
  # 2. Built-in table from task-drain.sh
  echo "  Built-in table (from task-drain.sh):"
  local projs=(attendeesync ncdlabs ncdlabs-assure ncdlabs-changepress ncdlabs-site-access-policies agentx innercircles gitseer meridian solfoundation)
  for proj in "${projs[@]}"; do
    local repo="$GIT_ROOT/$proj"
    case "$proj" in
      ncdlabs) repo="$GIT_ROOT/ncdlabs.com" ;;
      solfoundation) repo="$GIT_ROOT/wp-solfoundation-plugin" ;;
    esac
    if [ -d "$repo" ]; then
      echo "    $proj → $repo"
    else
      echo "    $proj → $repo (missing)"
    fi
  done
  echo
  # 3. Auto-detected from GIT_ROOT
  echo "  Auto-detected repos in $GIT_ROOT:"
  local found=0
  for dir in "$GIT_ROOT"/*/; do
    [ -d "$dir" ] || continue
    local name
    name=$(basename "$dir")
    # Skip if already listed above
    if [ -f "$conf" ] && grep -q "^${name}=" "$conf"; then continue; fi
    case " ${projs[*]} " in *" $name "*) continue ;; esac
    echo "    $name → $dir"
    found=1
  done
  [ "$found" = 0 ] && echo "    (none)"
  echo
  # 4. Projects with tasks
  echo "  Projects with pending tasks:"
  local tasks_projs
  tasks_projs=$("$TASK" _projects 2>/dev/null 2>/dev/null || echo "")
  if [ -n "$tasks_projs" ]; then
    for proj in $tasks_projs; do
      local count
      count=$("$TASK" "project:$proj" +PENDING -ACTIVE -WAITING count 2>/dev/null || echo "0")
      [ "$count" -gt 0 ] && echo "    $proj ($count pending)"
    done
  else
    echo "    (none)"
  fi
  echo "Effective mappings for task projects:"
  PROJECT_FILTER="" bash "$DRAIN_SCRIPT" mappings

}

cmd_projects_merge() { # [--dry-run] <destination> <source...>
  local preview=0
  if [ "${1:-}" = --dry-run ]; then preview=1; shift; fi
  [ "$#" -ge 2 ] || die "usage: drain projects merge [--dry-run] <destination> <source...>"
  local dest="$1" src data uuid changed=0 failed=0 actual
  shift
  for src in "$@"; do [ "$src" != "$dest" ] || die "cannot merge project into itself"; done
  "$TASK" sync || die "Sync failed before project merge"
  for src in "$@"; do
    # Exact project only: descendants must be explicitly named, avoiding accidental broad changes.
    data=$("$TASK" status:pending,waiting,completed,recurring,deleted export | jq --arg src "$src" '[.[] | select(.project == $src)]') || die "Task query failed"
    printf '%s\n' "$data" | jq -r --arg dst "$dest" '.[] | "\(.uuid) [\(.status)] \(.project) -> \($dst)"'
    [ "$preview" = 0 ] || continue
    while IFS= read -r uuid; do
      [ -n "$uuid" ] || continue
      if "$TASK" rc.confirmation=off "$uuid" modify "project:$dest"; then
        actual=$("$TASK" "$uuid" export | jq -r '.[0].project') || actual=""
        if [ "$actual" = "$dest" ]; then changed=$((changed + 1)); else failed=1; fi
      else failed=1; fi
    done < <(printf '%s' "$data" | jq -r '.[].uuid')
  done
  [ "$preview" = 0 ] || return 0
  "$TASK" sync || die "Local project changes applied; sync failed; inspect before retrying"
  echo "Verified $changed task(s) moved. Update repos.conf separately."
  [ "$failed" = 0 ] || die "Some changes failed verification"
}

cmd_help() {
  if [ $# -gt 0 ]; then
    help_for "$1"
  else
    awk 'NR==1{next} found{ if(/^#/||/^$/) print; else exit } /^#/{found=1; print}' "$0" | sed 's/^# //; s/^#//'
  fi
}

help_for() {
  case "$1" in
    status)
      cat <<'HELP'
drain status — show worker pool status

USAGE
  drain status [project] [-w|--watch] [--workers] [--verbose]

ARGUMENTS
  project          Limit to one project (e.g. drain status attendeesync)
                   'all' or no argument = all projects

OPTIONS
  -w, --watch      Live display, refreshes every DRAIN_WATCH_INTERVAL sec
  --workers        Live per-worker view: each worker's current task and
                   time-budget meter
  -v, --verbose    Show full task lists instead of the capped summary

EXAMPLES
  drain status
  drain status attendeesync
  drain status --watch
  drain status attendeesync --workers --verbose
HELP
      ;;
    start)
      cat <<'HELP'
drain start — start background workers

USAGE
  drain start [N] [project|all] [--failed] [--persist] [--autonomous]

ARGUMENTS
  N                Number of workers to start (default 2, max 8)
  project          Limit to one project (e.g. drain start 3 attendeesync)
                   'all' or no argument = take tasks from any project

OPTIONS
  --failed         Reprocess drain-failed tasks instead of the regular queue
  --persist        Workers wait for new jobs after the queue empties
                   instead of exiting
  --autonomous     Opt-in pickup mode: only tasks tagged +auto are eligible.
                   Also launches the autoscaler to pick up new tickets.

EXAMPLES
  drain start
  drain start 4
  drain start 3 attendeesync
  drain start 2 --failed
  drain start 2 attendeesync --failed
  drain start 2 --persist
  drain start 2 attendeesync --persist
  drain start --autonomous
  drain start 2 attendeesync --autonomous

Workers loop: sync -> pick highest-urgency eligible task -> claim it ->
run `opencode run` -> verify -> repeat until queue is empty, then exit
(or wait for new jobs if --persist).

Pickup is opt-out by default (all pending tasks are eligible unless tagged
noauto). With --autonomous, pickup is opt-in (only tasks tagged +auto).
HELP
      ;;
    unfail)
      cat <<'HELP'
drain unfail — remove drain-failed tag from failed tasks

USAGE
  drain unfail [project]

ARGUMENTS
  project          Limit to one project (e.g. drain unfail attendeesync)
                   No argument = all projects

EXAMPLES
  drain unfail
  drain unfail attendeesync

Removes the drain-failed tag from matching tasks, returning them to the
regular queue. Workers (persistent or autoscaled) will pick them up
on their next poll.
HELP
      ;;
    stop)
      cat <<'HELP'
drain stop — graceful stop

USAGE
  drain stop [N|all] [--force]

ARGUMENTS
  N                Stop N workers (newest first). N >= running stops all.
  all              Stop all workers (default)

OPTIONS
  --force          Immediate stop (TERM mid-task, like drain kill)

EXAMPLES
  drain stop
  drain stop all
  drain stop 2
  drain stop --force

With no --force: workers finish their current task, pick up nothing new,
then exit. With --force: workers are killed immediately; in-flight tasks
are released back to pending.
HELP
      ;;
    kill)
      cat <<'HELP'
drain kill — immediate stop

USAGE
  drain kill

TERM workers mid-task. In-flight tasks are released back to pending.
Same as `drain stop --force`.
HELP
      ;;
    autoscale)
      cat <<'HELP'
drain autoscale — supervisor daemon that scales workers to queue depth

USAGE
  drain autoscale [project] [--min N] [--max N]

ARGUMENTS
  project          Limit to one project (e.g. drain autoscale attendeesync)
                   'all' or no argument = all projects

OPTIONS
  --min N          Minimum workers to keep running (default 1)
  --max N          Maximum workers to start (default 8)

ENVIRONMENT
  DRAIN_MIN_WORKERS         Default for --min (default 1)
  DRAIN_MAX_WORKERS         Default for --max (default 8)
  DRAIN_AUTOSCALE_INTERVAL  Seconds between checks (default 30)
  DRAIN_TASKS_PER_WORKER    Eligible tasks per worker (default 2)

EXAMPLES
  drain autoscale
  drain autoscale attendeesync
  drain autoscale --min 2 --max 6
  drain autoscale attendeesync --min 0 --max 10

The autoscaler counts eligible tasks, computes desired workers as
ceil(eligible / DRAIN_TASKS_PER_WORKER), clamps to [--min, --max], then
starts or stops workers to match. If eligible=0 and min=0, it scales to
zero. Stop with: drain autoscale-stop
HELP
      ;;
    autoscale-stop)
      cat <<'HELP'
drain autoscale-stop — stop the autoscaler

USAGE
  drain autoscale-stop

Stops the autoscaler daemon. Workers already running are NOT affected —
they keep working until the queue is empty or they are stopped.
HELP
      ;;
    resume)
      cat <<'HELP'
drain resume — clear the kill switch

USAGE
  drain resume

Removes ~/.task-drain/STOP and all per-worker STOP.<pid> files. Does not
start workers — use `drain start` to launch them.
HELP
      ;;
    logs)
      cat <<'HELP'
drain logs — view worker logs

USAGE
  drain logs [-f]

OPTIONS
  -f               Follow (tail -f) all worker logs

Logs are at ~/.task-drain/logs/worker-<timestamp>-<pid>-N.log
HELP
      ;;
    history)
      cat <<'HELP'
drain history — show recently processed drain tasks

USAGE
  drain history [--limit N]

OPTIONS
  --limit N          Maximum number of entries to show (default 20)

Displays summary statistics (total processed, success rate, average
duration) followed by a table of the most recent drain completions
and failures. Workers record one entry per processed task in
~/.task-drain/history.log, which keeps a rolling window of the last
20 entries.

EXAMPLES
  drain history
  drain history --limit 10
  drain history --limit 50
HELP
      ;;
    pr)
      cat <<'HELP'
drain pr list — list open PRs created by drain agents

USAGE
   drain pr list [--json]

OPTIONS
   --json           Output raw JSON instead of formatted text

Lists open pull requests across all configured repos whose body references
a task UUID (created by drain workers via the git workflow). Shows repo,
PR number, title, URL, and linked task UUID.

EXAMPLES
   drain pr list
   drain pr list --json
HELP
      ;;
    config)
      cat <<'HELP'
drain config — inspect and initialize the unified YAML configuration

USAGE
  drain config show [--json]   Effective configuration with provenance
                               (source: default|yaml|environment|cli).
                               Secret values are never displayed.
  drain config validate        Validate the effective configuration.
                               Exit nonzero on failure with actionable errors.
  drain config path            Print the active configuration file path.
  drain config defaults        Print a complete commented template (stdout only,
                               never modifies files).
  drain config init            Create the default template (mode 600) only when
                               no config file exists. Never overwrites.

GLOBAL
  drain --config PATH <cmd>    Use PATH instead of ~/.task-drain/config.yaml
                               (also: DRAIN_CONFIG=PATH). Works consistently
                               across all subcommands.

EXAMPLES
  drain config path
  drain config validate
  drain config show
  drain config show --json
  drain config defaults
  drain config init

Configuration is side-effect-free except for the explicit `init` write.
See docs/configuration.md for the canonical schema reference.
HELP
      ;;
    projects)
      cat <<'HELP'
drain projects — list configured project → repo mappings

USAGE
  drain projects

Shows all project → repo mappings from:
  1. ~/.task-drain/repos.conf (primary)
  2. Built-in table in task-drain.sh
  3. Auto-detected repos in $GIT_ROOT
  4. Projects with pending tasks
HELP
      ;;
    projects-merge)
      cat <<'HELP'
drain projects merge — merge source projects into a destination

USAGE
  drain projects merge <destination> <source...>

Moves all tasks from each source project into the destination project.
At least 2 projects required (1 destination + 1+ sources).

EXAMPLES
  drain projects merge myproject old-project-a old-project-b
  drain projects merge solfoundation solfoundation.brevo-cleanup

Changes are synced automatically. Update repos.conf separately.
HELP
      ;;
    docs)
      cat <<'HELP'
drain docs — extended documentation

USAGE
  drain docs

Shows detailed docs on pickup rules, tags (noauto, auto, drain-failed,
drain-claimed), retrying failed tasks, the agent prompt, stopping, and
safety dials.
HELP
      ;;
    help)
      cat <<'HELP'
drain help — show help

USAGE
  drain help              List all commands
  drain help <command>     Detailed help for one command
  drain <command> help    Same as above

EXAMPLES
  drain help
  drain help autoscale
  drain autoscale help
HELP
      ;;
    *)
      die "no help for unknown command: $1"
      ;;
  esac
}

cmd_config_show() { # [--json]
  local json=0 a
  for a in "$@"; do
    case "$a" in
      --json) json=1 ;;
      -*) die "unknown config show option: $a (try: drain help config)" ;;
      *) die "unexpected argument: $a (try: drain help config)" ;;
    esac
  done
  if ! drain_config_valid >/dev/null 2>&1; then
    drain_config_valid >&2 || true
    exit 2
  fi
  if [ "$json" = 1 ]; then
    # Machine-readable: values + sources + path. Secrets are never stored in
    # YAML by design; env-only secrets are never emitted here.
    python3 "$SCRIPT_DIR/lib/drain-config.py" resolve --format json
  else
    python3 "$SCRIPT_DIR/lib/drain-config.py" resolve --format show
  fi
}

cmd_config_validate() {
  [ $# -eq 0 ] || die "usage: drain config validate (takes no arguments)"
  if python3 "$SCRIPT_DIR/lib/drain-config.py" validate; then
    echo "configuration valid: $(drain_config_path)"
  else
    exit 2
  fi
}

cmd_config_path() {
  [ $# -eq 0 ] || die "usage: drain config path (takes no arguments)"
  drain_config_path
}

cmd_config_defaults() {
  [ $# -eq 0 ] || die "usage: drain config defaults (takes no arguments)"
  python3 "$SCRIPT_DIR/lib/drain-config.py" defaults
}

cmd_config_init() {
  [ $# -eq 0 ] || die "usage: drain config init (takes no arguments)"
  local cfg
  cfg=$(drain_config_path)
  if [ -f "$cfg" ]; then
    die "refusing to overwrite existing configuration: $cfg"
  fi
  mkdir -p "$(dirname "$cfg")"
  # Valid minimal template: defaults only, no primary host, no autonomy.
  python3 "$SCRIPT_DIR/lib/drain-config.py" template >"$cfg.tmp.$$"
  chmod 600 "$cfg.tmp.$$"
  mv "$cfg.tmp.$$" "$cfg"
  chmod 600 "$cfg"
  echo "created $cfg (mode 600). Edit worker.primary_host only on the designated executor."
}

cmd_config() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    show) cmd_config_show "$@" ;;
    validate) cmd_config_validate "$@" ;;
    path) cmd_config_path "$@" ;;
    defaults) cmd_config_defaults "$@" ;;
    init) cmd_config_init "$@" ;;
    ""|help|--help|-h) help_for config ;;
    *) die "unknown config subcommand: $sub (try: drain help config)" ;;
  esac
}

cmd_docs() {
  cat "$SCRIPT_DIR/docs/operating-modes.md"
  printf '\nFull command reference: %s/docs/cli-reference.md\n' "$SCRIPT_DIR"
}

# Second-level help: drain <cmd> help
if [ $# -ge 2 ]; then
  case "$2" in
    help|--help|-h)
      cmd_help "$1"
      exit 0
      ;;
  esac
fi

case "${1:-}" in
  "") cmd_help ;;
  status) shift; cmd_status "$@" ;;
  docs) cmd_docs ;;
  start)  shift; cmd_start "$@" ;;
  stop)   shift; cmd_stop "$@" ;;
  kill)   cmd_kill ;;
  autoscale) shift; cmd_autoscale "$@" ;;
  autoscale-stop) cmd_autoscale_stop ;;
  unfail)
    shift
    if [ $# -gt 0 ] && [ "$1" = "help" ]; then
      help_for unfail
    else
      cmd_unfail "$@"
    fi
    ;;
  resume) cmd_resume ;;
  logs)   shift; cmd_logs "${1:-}" ;;
  history) shift; cmd_history "$@" ;;
  pr)
    shift
    if [ $# -gt 0 ] && [ "$1" = "help" ]; then
      help_for pr
    else
      # Strip the "list" subcommand if present
      if [ $# -gt 0 ] && [ "$1" = "list" ]; then shift; fi
      cmd_pr_list "$@"
    fi
    ;;
  config)
    shift
    cmd_config "$@"
    ;;
  projects)
    shift
    if [ $# -gt 0 ] && [ "$1" = "merge" ]; then
      shift
      if [ $# -gt 0 ] && [ "$1" = "help" ]; then
        help_for projects-merge
      else
        cmd_projects_merge "$@"
      fi
    elif [ $# -gt 0 ] && [ "$1" = "help" ]; then
      help_for projects
    else
      cmd_projects "$@"
    fi
    ;;
  help|--help|-h)
    if [ $# -ge 2 ] && [ -n "$2" ]; then cmd_help "$2"; else cmd_help; fi
    ;;
  *)      die "unknown command: $1 (try: drain help)" ;;
esac
