#!/usr/bin/env bash
export PATH=/opt/homebrew/bin:/usr/local/bin:$HOME/.opencode/bin:$HOME/bin:/usr/bin:/bin:/usr/sbin:/sbin
#
# drain -- CLI for the task-drain autonomous worker pool.
# Worker logic lives in the adjacent task-drain.sh; this is the human interface.
#
#   drain                show this help
#   drain status [project] [-w|--watch] [--workers] [--verbose]
#                        show status (workers, kill switch, queue),
#                        optionally scoped to one project; -w keeps a
#                        live display (q quits, DRAIN_WATCH_INTERVAL=5);
#                        --workers shows a live per-worker view instead:
#                        each worker's current task + time-budget meter;
#                        --verbose (or DRAIN_VERBOSE=1) shows full lists
#                        instead of the capped summary view
#   drain docs           how pickup, tags, and the kill switch work
#   drain start [N] [project|all] [--failed]
#                        start N background workers (default 2, max 8),
#                        optionally limited to one project, e.g.:
#                          drain start 3 attendeesync
#                        'all' (or no project) = take tasks from any project.
#                        --failed = reprocess drain-failed tasks instead of
#                        the regular queue, e.g.:
#                          drain start 2 attendeesync --failed
#   drain stop [N|all]   graceful stop: workers finish their current task,
#                        pick up nothing new, then exit.
#                        No arg (or 'all') = stop ALL workers.
#                        N = stop N workers (newest first).
#                        --force = immediate stop (TERM mid-task, like drain kill)
#   drain kill           immediate stop: TERM workers mid-task (in-flight
#                        tasks are released back to pending, cleanly)
#   drain autoscale [project] [--min N] [--max N]
#                        supervisor daemon: watches queue depth and scales
#                        workers up/down automatically. Defaults: --min 1,
#                        --max 8. Env: DRAIN_MIN_WORKERS, DRAIN_MAX_WORKERS,
#                        DRAIN_AUTOSCALE_INTERVAL (sec, default 30),
#                        DRAIN_TASKS_PER_WORKER (default 2).
#   drain autoscale-stop stop the autoscaler (workers keep running)
#   drain resume         clear the STOP file (does not start workers)
#   drain logs [-f]      tail worker logs (follow with -f)
#   drain help
#
# Workers log to ~/.task-drain/logs/worker-<timestamp>-<pid>-N.log.
#
set -euo pipefail

# Resolve symlinks so the script finds its siblings even when invoked
# through ~/bin/drain -> repo/bin/drain. macOS readlink lacks -f.
resolve_symlink() {
  local path="$1" target
  while [ -L "$path" ]; do
    target=$(readlink "$path")
    if [[ "$target" != /* ]]; then
      target="$(dirname -- "$path")/$target"
    fi
    path="$target"
  done
  printf '%s\n' "$path"
}

SCRIPT_PATH="$(resolve_symlink "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)"
DRAIN_SCRIPT="$SCRIPT_DIR/task-drain.sh"
DRAIN_HOME="$HOME/.task-drain"
LOG_DIR="$DRAIN_HOME/logs"
STOP_FILE="$DRAIN_HOME/STOP"

# Source shared worker detection functions
# shellcheck source=lib/worker-detect.sh
source "$SCRIPT_DIR/lib/worker-detect.sh"

die() { echo "drain: $*" >&2; exit 1; }

need_script() { [ -f "$DRAIN_SCRIPT" ] || die "worker script not found: $DRAIN_SCRIPT"; }

worker_pids() {
  # Use shared worker detection from lib/worker-detect.sh
  drain_worker_pids
}

worker_count() {
  local ps_out
  ps_out=$(worker_pids)
  if [ -z "$ps_out" ]; then echo 0; else printf '%s\n' "$ps_out" | wc -l | tr -d ' '; fi
}

prune_stale_stops() {
  # Drop per-worker STOP.<pid> files whose worker is already gone.
  local f pid alive
  alive=$(worker_pids)
  for f in "$DRAIN_HOME"/STOP.*; do
    [ -e "$f" ] || continue
    pid=${f##*.}
    [[ "$pid" =~ ^[0-9]+$ ]] || continue
    if ! printf '%s\n' "$alive" | grep -qx "$pid"; then rm -f "$f"; fi
  done
}

cmd_status() { # [project] [-w|--watch] [--workers] [--verbose]
  need_script
  local project="" watch=0 workers=0 verbose=0 a
  for a in "$@"; do
    case "$a" in
      -w|--watch) watch=1 ;;
      --workers) workers=1 ;;
      -v|--verbose) verbose=1 ;;
      -*) die "unknown status option: $a (try: drain help)" ;;
      *) [ -z "$project" ] || die "unexpected argument: $a (try: drain help)"; project="$a" ;;
    esac
  done
  [ "$project" = "all" ] && project=""
  if [ "$workers" = 1 ]; then
    PROJECT_FILTER="$project" bash "$DRAIN_SCRIPT" workers
  elif [ "$watch" = 1 ]; then
    if [ "$verbose" = 1 ]; then export DRAIN_VERBOSE=1; fi
    PROJECT_FILTER="$project" bash "$DRAIN_SCRIPT" watch
  else
    if [ "$verbose" = 1 ]; then export DRAIN_VERBOSE=1; fi
    PROJECT_FILTER="$project" bash "$DRAIN_SCRIPT" status
  fi
}

cmd_start() { # [N] [project|all] [--failed]
  need_script
  local n="" project="" retry=0 running i logf a
  for a in "$@"; do
    case "$a" in
      "") ;;
      --failed) retry=1 ;;
      *)
        if [[ "$a" =~ ^[0-9]+$ ]] && [ -z "$n" ]; then n="$a"
        elif [ -z "$project" ]; then project="$a"
        else die "unexpected argument: $a (try: drain help)"; fi ;;
    esac
  done
  [ -n "$n" ] || n=2
  [[ "$n" =~ ^[1-9][0-9]*$ ]] || die "N must be a positive integer"
  [ "$n" -le 8 ] || die "max 8 workers"
  [ "$project" = "all" ] && project=""
  mkdir -p "$LOG_DIR"
  if [ -e "$STOP_FILE" ]; then rm -f "$STOP_FILE"; echo "cleared STOP file."; fi
  prune_stale_stops
  running=$(worker_count)
  if [ "$running" -gt 0 ]; then echo "note: $running worker(s) already running; starting $n more."; fi
  [ -n "$project" ] && export PROJECT_FILTER="$project"
  [ "$retry" = 1 ] && export DRAIN_RETRY_FAILED=1
  local mode_desc=""
  [ -n "$project" ] && mode_desc=" [project=$project]"
  [ "$retry" = 1 ] && mode_desc="$mode_desc [retrying failed]"
  for i in $(seq 1 "$n"); do
    # Timestamp + CLI pid in the name so a second `drain start` never
    # overwrites the logs of already-running workers.
    logf="$LOG_DIR/worker-$(date '+%Y%m%d-%H%M%S')-$$-$i.log"
    { echo ""; echo "===== run started $(date '+%F %T')$mode_desc ====="; } >>"$logf"
    nohup bash "$DRAIN_SCRIPT" >>"$logf" 2>&1 &
    echo "started worker $i (pid $!$mode_desc, log $logf)"
  done
  if [ "$retry" = 1 ]; then
    echo "They'll reprocess failed tasks (one retry each), then exit. 'drain stop' to halt."
  else
    echo "They'll work until the queue is empty, then exit. 'drain stop' to halt."
  fi
}

cmd_autoscale() { # [project] [--min N] [--max N]
  # Supervisor daemon: watches queue depth and scales workers up/down.
  need_script
  local project="" min_w="" max_w="" a
  for a in "$@"; do
    case "$a" in
      --min) shift; min_w="$1"; shift ;;
      --max) shift; max_w="$1"; shift ;;
      --min=*) min_w="${a#--min=}" ;;
      --max=*) max_w="${a#--max=}" ;;
      "") ;;
      -*) die "unknown autoscale option: $a (try: drain help)" ;;
      *) [ -z "$project" ] || die "unexpected argument: $a"; project="$a" ;;
    esac
  done
  [ "$project" = "all" ] && project=""
  min_w="${min_w:-${DRAIN_MIN_WORKERS:-1}}"
  max_w="${max_w:-${DRAIN_MAX_WORKERS:-8}}"
  [[ "$min_w" =~ ^[0-9]+$ ]] || die "--min must be a non-negative integer"
  [[ "$max_w" =~ ^[1-9][0-9]*$ ]] || die "--max must be a positive integer"
  [ "$min_w" -le "$max_w" ] || die "--min cannot exceed --max"

  local pidfile="$DRAIN_HOME/autoscale.pid"
  if [ -f "$pidfile" ] && kill -0 "$(cat "$pidfile")" 2>/dev/null; then
    die "autoscaler already running (pid $(cat "$pidfile")). 'drain autoscale-stop' first."
  fi

  mkdir -p "$LOG_DIR"
  [ -n "$project" ] && export PROJECT_FILTER="$project"
  export DRAIN_MIN_WORKERS="$min_w" DRAIN_MAX_WORKERS="$max_w"

  echo "starting autoscaler (min=$min_w max=$max_w${project:+ project=$project})..."
  nohup bash "$DRAIN_SCRIPT" autoscale >>"$LOG_DIR/autoscale.log" 2>&1 &
  echo $! > "$pidfile"
  echo "autoscaler running (pid $!). 'drain autoscale-stop' to halt."
}

cmd_autoscale_stop() {
  local pidfile="$DRAIN_HOME/autoscale.pid"
  if [ ! -f "$pidfile" ]; then echo "no autoscaler running."; return 0; fi
  local pid
  pid=$(cat "$pidfile")
  if kill -0 "$pid" 2>/dev/null; then
    kill -TERM "$pid" 2>/dev/null
    echo "autoscaler (pid $pid) stopping..."
  else
    echo "autoscaler pid $pid not running; cleaning up."
  fi
  rm -f "$pidfile"
}

cmd_stop() { # [N|all] [--force] -- default all
  local target="all" force=0 a
  for a in "$@"; do
    case "$a" in
      --force) force=1 ;;
      "") ;;
      all) target="all" ;;
      *)
        [[ "$a" =~ ^[1-9][0-9]*$ ]] || die "usage: drain stop [N|all] [--force]"
        [ "$target" = "all" ] || die "drain stop: only one positional argument allowed (got '$a' after '$target')"
        target="$a"
        ;;
    esac
  done
  if [ "$force" = 1 ] && [ "$target" != "all" ]; then
    die "drain stop --force: N is not compatible with --force (force stops all workers)"
  fi
  mkdir -p "$DRAIN_HOME"
  prune_stale_stops
  local running pids pid stopped=0
  running=$(worker_count)
  [ "$running" -gt 0 ] || { echo "no workers running."; return 0; }
  if [ "$force" = 1 ]; then
    pkill -TERM -f "(^|[^A-Za-z0-9_-])task-drain\.sh$"
    echo "force stop: TERM sent to all $running worker(s). In-flight tasks released to pending."
  elif [ "$target" = "all" ]; then
    touch "$STOP_FILE"
    echo "graceful stop requested for all $running worker(s). They'll exit after their current task."
  elif [ "$target" -ge "$running" ]; then
    touch "$STOP_FILE"
    echo "graceful stop requested for all $running worker(s) ($target >= running). They'll exit after their current task."
  else
    pids=$(worker_pids)
    while IFS= read -r pid; do
      [ -n "$pid" ] || continue
      [ "$stopped" -lt "$target" ] || break
      touch "$STOP_FILE.$pid"
      echo "graceful stop requested for worker pid $pid (finishes current task, then exits)."
      stopped=$((stopped+1))
    done <<<"$pids"
    echo "$stopped of $running worker(s) stopping. Check with: drain status"
  fi
  [ "$force" = 1 ] || echo "Check with: drain status"
}

cmd_kill() {
  if [ "$(worker_count)" -gt 0 ]; then
    pkill -TERM -f "(^|[^A-Za-z0-9_-])task-drain\.sh$"
    echo "TERM sent. In-flight tasks are released back to pending."
  else
    echo "no workers running."
  fi
}

cmd_resume() {
  rm -f "$STOP_FILE" "$DRAIN_HOME"/STOP.*
  echo "STOP cleared (global + per-worker). Start workers with: drain start [N] [project]"
}

cmd_logs() { # [-f]
  local follow=0 l
  [ "${1:-}" = "-f" ] && follow=1
  local logs=( "$LOG_DIR"/worker-*.log )
  [ -e "${logs[0]}" ] || die "no worker logs yet in $LOG_DIR"
  if [ "$follow" = 1 ]; then
    tail -f "${logs[@]}"
  else
    for l in "${logs[@]}"; do echo "--- $l"; tail -n 30 "$l"; done
  fi
}

cmd_help() {
  awk 'NR<2{next} /^#/||/^$/{print; next} {exit}' "$0" | sed 's/^# //; s/^#//'
}

cmd_docs() {
  cat <<'DOCS_EOF'
DRAIN -- autonomous Taskwarrior queue workers
============================================

WHAT IT DOES
  Each worker loops: sync -> pick the highest-urgency eligible task ->
  claim it -> run `opencode run` on it -> verify -> repeat until the
  queue is empty, then exits.

WHAT GETS PICKED UP
  Nothing special is required. Pickup is OPT-OUT: any task is eligible
  unless it is:
    - already active (started by someone or something)
    - waiting (scheduled for a future date)
    - blocked (has an unmet dependency)
    - tagged noauto        (your opt-out)
    - tagged drain-failed  (a worker already tried and couldn't finish it)
  Among eligible tasks, highest urgency goes first. Limit to one project:
    drain start 2 attendeesync

TAGS
  noauto
    Tag a task and drain workers will never touch it. Use for tasks that
    need you, interactive-only work, or anything you don't want a free
    model grinding on unattended:
      task <uuid> modify +noauto
  drain-failed
    Set automatically when a worker attempt ends without the task being
    completed (agent failed it, crashed, timed out, or finished nothing).
    Regular workers never retry these. To give them another shot, either
    re-queue (a normal worker picks it up):
      task <uuid> modify -drain-failed
    or retry directly without untagging:
      drain start 2 --failed                (all projects)
      drain start 2 attendeesync --failed   (one project)
    A --failed retry that fails again keeps drain-failed; each task gets
    at most one retry per --failed run, so nothing loops forever.
    Everything failed is listed under `drain status` ("needs human review").
  drain-claimed
    Set automatically while a worker owns a task. Don't set it by hand.
    If a worker dies mid-task, its claim is auto-released after 4 hours.
    Only worker claims are ever released -- your interactive sessions'
    active tasks are never touched.

RETRYING FAILED TASKS
  drain start [N] [project] --failed
    Spins up workers that reprocess drain-failed tasks instead of the
    regular queue. The failed set is snapshotted when each worker starts;
    every failed task gets at most one retry per run, so a task that fails
    again can't loop -- it keeps drain-failed for the next explicit retry.
    Combine with a project:  drain start 2 attendeesync --failed

WHAT THE AGENT IS TOLD
  Every worker hands its task to `opencode run` with a prompt enforcing:
    - Taskwarrior is the only system of record. Sync at session start,
      after every change, and at session end. Never work offline. Never
      change the sync client ID. Reference tasks by UUID, never short IDs.
    - Authority: design, security, product, and public-facing decisions
      belong to the project owner (see DRAIN_OWNER in task-drain.sh).
      If the task needs human judgment, credentials it lacks, a
      legal/compliance declaration, or anything public or irreversible,
      the agent must annotate what's needed and FAIL the task -- never
      decide on its own.
    - Completion contract: verify for real (build, tests, or the task's
      own acceptance criteria). Only then `task <uuid> done`. Partial or
      unverified work is failed, never marked done.

STOPPING
  drain stop        graceful all: no new pickups; in-flight tasks finish, workers exit
  drain stop all    same as bare 'drain stop'
  drain stop N      graceful: stop N workers (newest first); each finishes its
                    current task, then exits. N >= running stops all.
  drain stop --force  immediate: TERM workers mid-task; claims released to pending
                    (same as drain kill, but via the stop command)
  drain kill    immediate: workers die mid-task; claims released to pending
  drain resume  clear the STOP file (doesn't start workers)

LOGS
  ~/.task-drain/logs/worker-<timestamp>-<pid>-N.log      drain logs [-f]

VIEWS
  drain status              queue dashboard (one snapshot)
  drain status -w           same, live (q quits, DRAIN_WATCH_INTERVAL=5)
  drain status --workers    live per-worker view: each worker's current
                            task + time-budget meter (q quits). With a
                            project, other projects are dimmed:
                              drain status attendeesync --workers

SAFETY DIALS (env vars, or edit at the top of task-drain.sh)
  DRAIN_SKIP_PERMISSIONS=1      : adds --dangerously-skip-permissions to
      opencode run flags. Without it, unattended runs stall on the first
      approval prompt. With it, the agent can edit, run, and push without
      asking. This is the main risk dial -- only enable if you trust the
      autonomous worker to operate without human approval.
  DRAIN_MODEL                  : model for worker runs
                                  (default opencode-go/longcat-2.5-preview-free)
  STALE_AFTER_SEC=14400  : release worker claims older than 4 hours
  TASK_TIMEOUT_SEC=14400 : per-task wall clock (needs `gtimeout`)
DOCS_EOF
}

case "${1:-}" in
  "") cmd_help ;;
  status) shift; cmd_status "$@" ;;
  docs) cmd_docs ;;
  start)  shift; cmd_start "$@" ;;
  stop)   shift; cmd_stop "$@" ;;
  kill)   cmd_kill ;;
  autoscale) shift; cmd_autoscale "$@" ;;
  autoscale-stop) cmd_autoscale_stop ;;
  resume) cmd_resume ;;
  logs)   shift; cmd_logs "${1:-}" ;;
  help|--help|-h) cmd_help ;;
  *)      die "unknown command: $1 (try: drain help)" ;;
esac
